{
  "name": "p2p-direct-beam",
  "version": "1.0.0",
  "description": "Zero-cloud high-throughput WebRTC disk-to-disk transfer",
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/tailwind.min.css --minify",
    "build:js": "esbuild public/app.js --minify --outfile=public/app.min.js && esbuild public/js/beam-canvas.js --minify --outfile=public/js/beam-canvas.min.js",
    "build": "npm run build:css && npm run build:js && wrangler deploy --dry-run",
    "deploy": "npm run build:css && npm run build:js && wrangler deploy",
    "test": "node test/security_flow.test.mjs"
  },
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^3.4.17",
    "wrangler": "^4.151.1"
  }
}
